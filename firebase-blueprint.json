{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account, cloud sync status, and server-managed PRO / Business subscription state",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified user Google email",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 120
        },
        "username": {
          "type": "string",
          "description": "Globally unique lowercase handle for direct organization member addition",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_]{3,30}$"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar URL",
          "maxLength": 1024
        },
        "hasCompletedOnboarding": {
          "type": "boolean",
          "description": "Whether the user has completed initial workspace/currency onboarding"
        },
        "isPro": {
          "type": "boolean",
          "description": "Server-managed or coupon-activated active Raseedi PRO entitlement"
        },
        "proActive": {
          "type": "boolean",
          "description": "Active PRO / Business subscription flag updated upon coupon activation"
        },
        "proPlan": {
          "type": "string",
          "enum": ["free", "monthly", "yearly", "lifetime", "business_monthly", "business_yearly", "trial", "code"],
          "description": "Server-managed active PRO subscription or code tier"
        },
        "planTier": {
          "type": "string",
          "enum": ["free", "personal_pro", "business_pro"],
          "description": "Server-managed entitlement tier"
        },
        "billingCycle": {
          "type": "string",
          "enum": ["free", "monthly", "yearly", "lifetime", "trial", "code"],
          "description": "Server-managed billing cycle"
        },
        "startedAt": {
          "type": "number",
          "description": "Subscription start or renewal epoch milliseconds (null for free)"
        },
        "expiresAt": {
          "type": "number",
          "description": "Server-managed subscription expiration epoch milliseconds (null for lifetime/free)"
        },
        "proExpiresAt": {
          "type": "number",
          "description": "Server-managed subscription expiration epoch milliseconds alias (null for lifetime/free)"
        },
        "hasUsedBusinessTrial": {
          "type": "boolean",
          "description": "Server-managed flag tracking 14-day business trial usage"
        },
        "activationCodeHash": {
          "type": "string",
          "description": "Server-recorded SHA-256 hash of redeemed PRO activation code",
          "maxLength": 128
        },
        "redeemedCouponCode": {
          "type": "string",
          "description": "Coupon code redeemed by user from coupons collection",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lastSyncedAt": {
          "type": "number",
          "description": "Epoch milliseconds of last cloud backup sync"
        },
        "currencyRates": {
          "type": "object",
          "description": "Cached live USD exchange rates map synced via merge update"
        },
        "settings": {
          "type": "object",
          "description": "Non-privileged user currency and app settings synced via merge update"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "email", "isPro", "createdAt", "updatedAt"]
    },
    "CloudBackupMeta": {
      "title": "CloudBackupMeta",
      "description": "Chunked backup metadata, wallets, categories, budgets, debts, goals, templates, and settings",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "schemaVersion": {
          "type": "number",
          "description": "Backup schema version (2 = chunked)"
        },
        "chunkCount": {
          "type": "number",
          "description": "Number of transaction chunk documents in backupChunks"
        },
        "totalTransactions": {
          "type": "number",
          "description": "Total transactions stored across chunks"
        },
        "wallets": { "type": "array", "description": "User wallets list" },
        "categories": { "type": "array", "description": "User categories list" },
        "budgets": { "type": "array", "description": "User budgets list" },
        "debts": { "type": "array", "description": "User debts list" },
        "goals": { "type": "array", "description": "User savings goals list" },
        "templates": { "type": "array", "description": "User quick templates list" },
        "moneyCircles": { "type": "array", "description": "Personal money circles (ROSCA) list" },
        "orgWorkspaces": { "type": "object", "description": "Enterprise organization workspaces keyed by orgId" },
        "activeWorkspace": { "type": "string", "description": "Active workspace mode ('personal' or orgId)", "maxLength": 128 },
        "settings": { "type": "object", "description": "App settings object" },
        "hasCompletedOnboarding": { "type": "boolean", "description": "Whether onboarding is completed" },
        "updatedAtMs": { "type": "number", "description": "Latest backup write epoch ms" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": [
        "uid",
        "schemaVersion",
        "chunkCount",
        "totalTransactions",
        "wallets",
        "categories",
        "budgets",
        "debts",
        "goals",
        "templates",
        "settings",
        "hasCompletedOnboarding",
        "updatedAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudBackupChunk": {
      "title": "CloudBackupChunk",
      "description": "Chunk document containing up to 400 transactions for scalable cloud backup",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chunkIndex": { "type": "number", "description": "Zero-based chunk sequence index" },
        "transactions": { "type": "array", "description": "Slice of user transactions" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": ["uid", "chunkIndex", "transactions", "updatedAt"]
    },
    "CloudBackupHistoryEntry": {
      "title": "CloudBackupHistoryEntry",
      "description": "Timestamped automatic cloud backup snapshot (retained up to latest 7 per user)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "source": { "type": "string", "enum": ["auto", "manual"] },
        "createdAtMs": { "type": "number" },
        "totalTransactions": { "type": "number" },
        "storedTransactionsCount": { "type": "number" },
        "walletsCount": { "type": "number" },
        "snapshotJson": { "type": "string", "maxLength": 900000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "uid",
        "source",
        "createdAtMs",
        "totalTransactions",
        "storedTransactionsCount",
        "walletsCount",
        "snapshotJson",
        "createdAt"
      ]
    },
    "ActivationCode": {
      "title": "ActivationCode",
      "description": "Server-only hashed PRO / Business activation codes redeemed atomically via /api/redeem-code",
      "type": "object",
      "properties": {
        "plan": {
          "type": "string",
          "enum": ["monthly", "yearly", "lifetime", "business_monthly", "business_yearly", "code"],
          "description": "Plan unlocked by this code"
        },
        "usedBy": { "type": "string", "description": "UID of user who redeemed this code" },
        "usedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of redemption" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["plan", "createdAt"]
    },
    "AdminIssuedCode": {
      "title": "AdminIssuedCode",
      "description": "Legacy server-only hashed PRO / Business activation codes",
      "type": "object",
      "properties": {
        "codeHash": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tier": { "type": "string", "enum": ["pro", "business"] },
        "cycle": { "type": "string", "enum": ["monthly", "yearly", "lifetime"] },
        "planTier": { "type": "string", "enum": ["personal_pro", "business_pro"] },
        "issuedByUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "issuedByEmail": { "type": "string", "format": "email", "maxLength": 254 },
        "targetEmail": { "type": "string", "maxLength": 254 },
        "usedBy": { "type": "string", "maxLength": 128 },
        "usedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["codeHash", "tier", "cycle", "planTier", "issuedByUid", "issuedByEmail", "createdAt"]
    },
    "AdminPanelConfig": {
      "title": "AdminPanelConfig",
      "description": "Encrypted salted scrypt Admin Panel PIN configuration writable solely by exclusive system admin (hapaypal2003@gmail.com)",
      "type": "object",
      "properties": {
        "pinHash": {
          "type": "string",
          "description": "Salted scrypt password hash (scrypt$<32-hex-salt>$<128-hex-hash>)",
          "maxLength": 256
        },
        "updatedByUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedByEmail": { "type": "string", "format": "email", "maxLength": 254 },
        "updatedAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["pinHash", "updatedByUid", "updatedByEmail", "updatedAtMs", "updatedAt"]
    },
    "LicenseCode": {
      "title": "LicenseCode",
      "description": "Server-generated hashed PRO / Business license codes managed exclusively by exclusive system admin",
      "type": "object",
      "properties": {
        "codeHash": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "codePreview": { "type": "string", "maxLength": 32 },
        "plan": { "type": "string", "enum": ["monthly", "yearly", "lifetime", "business_monthly", "business_yearly", "code"] },
        "tier": { "type": "string", "enum": ["pro", "business"] },
        "planTier": { "type": "string", "enum": ["personal_pro", "business_pro"] },
        "cycle": { "type": "string", "enum": ["monthly", "yearly", "lifetime"] },
        "targetEmail": { "type": "string", "maxLength": 254 },
        "status": { "type": "string", "enum": ["unused", "used"] },
        "used": { "type": "boolean" },
        "usedBy": { "type": "string", "maxLength": 128 },
        "usedOrgId": { "type": "string", "maxLength": 128 },
        "usedAt": { "type": "string", "format": "date-time" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdByEmail": { "type": "string", "format": "email", "maxLength": 254 },
        "createdAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["codeHash", "codePreview", "plan", "tier", "planTier", "cycle", "status", "used", "createdByUid", "createdByEmail", "createdAtMs", "createdAt"]
    },
    "JoinRateLimit": {
      "title": "JoinRateLimit",
      "description": "Server-only persistent brute-force protection state for /api/org/join",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "failures": { "type": "number" },
        "windowStartMs": { "type": "number" },
        "blockedUntilMs": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "failures", "windowStartMs", "updatedAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Legacy server-only activation coupons",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Unique uppercase coupon code",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tier": {
          "type": "string",
          "enum": ["pro", "business"],
          "description": "Selected subscription package"
        },
        "planTier": {
          "type": "string",
          "enum": ["personal_pro", "business_pro"],
          "description": "Resolved entitlement tier"
        },
        "cycle": {
          "type": "string",
          "enum": ["monthly", "yearly", "lifetime"],
          "description": "Activation duration cycle"
        },
        "status": {
          "type": "string",
          "enum": ["unused", "used"],
          "description": "Coupon usage status"
        },
        "used": {
          "type": "boolean",
          "description": "Whether coupon has been redeemed"
        },
        "usedBy": {
          "type": "string",
          "description": "UID of user who redeemed the coupon",
          "maxLength": 128
        },
        "usedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of coupon redemption"
        },
        "createdByUid": {
          "type": "string",
          "description": "Admin Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByEmail": {
          "type": "string",
          "format": "email",
          "description": "Admin email address",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": ["code", "tier", "planTier", "cycle", "status", "used", "createdByUid", "createdByEmail", "createdAt"]
    },
    "ScanQuota": {
      "title": "ScanQuota",
      "description": "Server-only monthly AI receipt scan counter per user",
      "type": "object",
      "properties": {
        "month": { "type": "string", "description": "YYYY-MM month key" },
        "count": { "type": "number", "description": "Number of receipt scans used in the month" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": ["month", "count", "updatedAt"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Enterprise workspace root container with VAT, approval threshold, accounting period lock, and server-managed Business entitlement",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "currency": { "type": "string", "maxLength": 8 },
        "industry": { "type": "string", "enum": ["retail", "restaurant", "tech", "construction", "medical", "general"] },
        "vatRate": { "type": "number" },
        "taxNumber": { "type": "string", "maxLength": 64 },
        "approvalThreshold": { "type": "number" },
        "lockedUntilDate": { "type": "string", "maxLength": 16 },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planTier": { "type": "string", "enum": ["free", "business_pro"] },
        "billingCycle": { "type": "string", "enum": ["free", "monthly", "yearly", "lifetime", "trial", "code"] },
        "expiresAt": { "type": "number" },
        "seatLimit": { "type": "number" },
        "extraSeats": { "type": "number" },
        "aiScansUsed": { "type": "number" },
        "aiScansMonth": { "type": "string", "maxLength": 16 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "currency", "vatRate", "approvalThreshold", "ownerUid", "planTier", "seatLimit", "createdAt", "updatedAt"]
    },
    "OrgRef": {
      "title": "OrgRef",
      "description": "Server-managed membership index under users/{uid}/orgRefs/{orgId}",
      "type": "object",
      "properties": {
        "orgId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orgName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["owner", "admin", "accountant", "employee", "viewer"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "currency": { "type": "string", "maxLength": 8 },
        "joinedAt": { "type": "number" }
      },
      "required": ["orgId", "orgName", "role", "status", "currency", "joinedAt"]
    },
    "OrganizationInvite": {
      "title": "OrganizationInvite",
      "description": "Server-only hashed organization invitation record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orgId": { "type": "string", "maxLength": 128 },
        "codeHash": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "accountant", "employee", "viewer"] },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "revoked", "exhausted"] }
      },
      "required": ["id", "orgId", "codeHash", "role", "createdBy", "createdAt", "expiresAt", "maxUses", "usedCount", "status"]
    },
    "OrganizationMember": {
      "title": "OrganizationMember",
      "description": "Member role & spending limit inside an organization",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 120 },
        "username": { "type": "string", "minLength": 3, "maxLength": 30, "pattern": "^[a-z0-9_]{3,30}$" },
        "role": { "type": "string", "enum": ["owner", "admin", "accountant", "employee", "viewer"] },
        "department": { "type": "string", "maxLength": 80 },
        "spendingLimit": { "type": "number" },
        "spendingLimitMinor": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "joinedAt": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status", "joinedAt", "updatedAt"]
    },
    "CostCenter": {
      "title": "CostCenter",
      "description": "Department or project cost center with allocated budget",
