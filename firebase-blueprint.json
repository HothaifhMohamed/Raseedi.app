        "budgetAllocatedMinor": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "code", "nameAr", "nameEn", "budgetAllocated", "isActive", "createdAt", "updatedAt"]
