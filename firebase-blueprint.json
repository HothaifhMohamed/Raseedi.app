      "required": ["id", "orgId", "action", "entityType", "entityId", "actorUid", "actorName", "summary", "timestamp", "createdAt"]
    },
    "WorkspaceContainer": {
      "title": "WorkspaceContainer",
      "description": "User-scoped workspace container ('personal' or local organization workspace)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "updatedAt"]
    },
    "WorkspaceTransactionRecord": {
      "title": "WorkspaceTransactionRecord",
      "description": "Unified real-time cloud transaction record scoped strictly to users/{userId}/workspaces/{workspaceId}/transactions/{txId}",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 16 },
        "time": { "type": "string", "maxLength": 16 },
        "type": { "type": "string", "enum": ["expense", "income", "transfer"] },
        "amount": { "type": "number" },
        "amountMinor": { "type": "number" },
        "currency": { "type": "string", "maxLength": 8 },
        "walletId": { "type": "string", "maxLength": 128 },
        "toWalletId": { "type": "string", "maxLength": 128 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "createdAtMs": { "type": "number" },
        "updatedAtMs": { "type": "number" },
        "deletedAt": { "type": "number" },
        "payload": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "workspaceId", "date", "type", "amount", "currency", "walletId", "categoryId", "payload", "updatedAt"]
    },
    "UsernameRecord": {
      "title": "UsernameRecord",
      "description": "Exact-key unique handle reservation enabling direct organization member lookup without listing or exposing users/{uid}",
      "type": "object",
      "properties": {
        "username": { "type": "string", "minLength": 3, "maxLength": 30, "pattern": "^[a-z0-9_]{3,30}$" },
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "uid", "displayName", "updatedAt"]
    },
    "UserEmailIndexRecord": {
      "title": "UserEmailIndexRecord",
      "description": "Exact SHA-256 email hash lookup document (no list allowed) for direct organization member addition",
      "type": "object",
      "properties": {
        "emailHash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 120 },
        "username": { "type": "string", "minLength": 3, "maxLength": 30, "pattern": "^[a-z0-9_]{3,30}$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["emailHash", "uid", "email", "displayName", "updatedAt"]
    }
  },
