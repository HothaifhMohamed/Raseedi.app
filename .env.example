# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional Gemini model ID override for server-side receipt scanning (defaults to gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Optional comma-separated list of trusted CORS origins for /api/* requests
# ALLOWED_ORIGINS="https://your-app.example.com"

# ADMIN_EMAILS: Comma-separated list of verified admin email addresses authorized for /api/admin/*
# ADMIN_EMAILS="admin@example.com"

# ADMIN_PASSCODE: Secret server-only passcode required to unlock the admin panel session
# ADMIN_PASSCODE=""

# PAYMENT_WEBHOOK_SECRET: HMAC-SHA256 secret used by /api/billing/webhook and /api/webhooks/payment
# PAYMENT_WEBHOOK_SECRET=""

# Optional Google AdSense client and default slot IDs for free-tier AdBanner
# VITE_ADSENSE_CLIENT_ID=""
# VITE_ADSENSE_SLOT_ID=""
