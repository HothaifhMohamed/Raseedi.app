rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsername(handle) {
      return handle is string && handle.size() >= 3 && handle.size() <= 30 && handle.matches('^[a-z0-9_]{3,30}$');
    }

    function isValidEmailHash(hash) {
      return hash is string && hash.size() == 64 && hash.matches('^[a-f0-9]{64}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser()
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && request.auth.token.email.trim().lower() == 'hapaypal2003@gmail.com';
    }

    function isValidAdminPanelConfig(data) {
      return data.keys().hasAll(['pinHash', 'updatedByUid', 'updatedByEmail', 'updatedAtMs', 'updatedAt'])
        && data.keys().hasOnly(['pinHash', 'updatedByUid', 'updatedByEmail', 'updatedAtMs', 'createdAt', 'updatedAt'])
        && data.pinHash is string
        && data.pinHash.size() >= 32
        && data.pinHash.size() <= 256
        && data.pinHash.matches('^(scrypt\\$[0-9a-f]{32}\\$[0-9a-f]{128}|pbkdf2\\$100000\\$[0-9a-f]{32}\\$[0-9a-f]{64})$')
        && data.updatedByUid is string
        && data.updatedByUid == request.auth.uid
        && isValidId(data.updatedByUid)
        && data.updatedByEmail is string
        && data.updatedByEmail.trim().lower() == 'hapaypal2003@gmail.com'
        && data.updatedAtMs is number
        && data.updatedAtMs > 0
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt is timestamp;
    }

    // Single-read Organization RBAC & Subscription helpers
    function memberDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function orgDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId));
    }

    function isOrgMemberActive(orgId) {
      let m = memberDoc(orgId);
      return isSignedIn() && m != null && m.data.status == 'active';
    }

    function isOrgOwnerOrAdmin(orgId) {
      let m = memberDoc(orgId);
      return isSignedIn() && m != null && m.data.status == 'active' && m.data.role in ['owner', 'admin'];
    }

    function isOrgAccountantOrAbove(orgId) {
      let m = memberDoc(orgId);
      return isSignedIn() && m != null && m.data.status == 'active' && m.data.role in ['owner', 'admin', 'accountant'];
    }

    function isOrgContributorOrAbove(orgId) {
      let m = memberDoc(orgId);
      return isSignedIn() && m != null && m.data.status == 'active' && m.data.role in ['owner', 'admin', 'accountant', 'employee'];
    }

    // Free orgs are always writable; paid/trial orgs stay writable through 7-day grace window
    function isOrgWritable(orgId) {
      let o = orgDoc(orgId);
      return o != null
        && (
          o.data.get('planTier', 'business_pro') == 'free'
          || o.data.get('billingCycle', 'monthly') == 'free'
          || !('expiresAt' in o.data)
          || o.data.expiresAt == null
          || request.time.toMillis() <= o.data.expiresAt + 7 * 86400000
        );
    }

    function isAfterPeriodLock(orgId, dateStr) {
      let o = orgDoc(orgId);
      return o != null
        && (!('lockedUntilDate' in o.data) || o.data.lockedUntilDate == null || o.data.lockedUntilDate == '' || dateStr > o.data.lockedUntilDate);
    }

    function currencyMinorFactor(currencyCode) {
      return currencyCode in ['KWD', 'BHD', 'OMR', 'JOD', 'TND', 'LYD', 'IQD'] ? 1000 : 100;
    }

    function isConsistentAmountMinor(orgId, data) {
      let o = orgDoc(orgId);
      let curr = ('currency' in data.payload && data.payload.currency is string)
        ? data.payload.currency
        : (o != null ? o.data.get('currency', 'EGP') : 'EGP');
      let factor = currencyMinorFactor(curr);
      return data.payload.amount is number
        && data.payload.amount >= 0
        && math.abs(data.amountMinor - math.round(data.payload.amount * factor)) <= 1;
    }

    function isWithinEmployeeSpendingLimit(orgId, data) {
      let m = memberDoc(orgId);
      return !('spendingLimit' in m.data)
        || m.data.spendingLimit == null
        || m.data.spendingLimit <= 0
        || (
          'spendingLimitMinor' in m.data
          && m.data.spendingLimitMinor is int
          && m.data.spendingLimitMinor > 0
          && 'amountMinor' in data
          && data.amountMinor is int
          && data.amountMinor <= m.data.spendingLimitMinor
          && 'payload' in data
          && 'amount' in data.payload
          && data.payload.amount is number
          && data.payload.amount <= m.data.spendingLimit
        );
    }

    function isValidUsernameRecord(data, username) {
      return data.keys().hasAll(['username', 'uid', 'email', 'displayName', 'updatedAt'])
        && data.keys().hasOnly(['username', 'uid', 'email', 'displayName', 'updatedAt'])
        && data.username is string
        && data.username == username
        && isValidUsername(data.username)
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 120
        && data.updatedAt is timestamp;
    }

    function isValidUserEmailIndexRecord(data, emailHash) {
      return data.keys().hasAll(['emailHash', 'uid', 'email', 'displayName', 'updatedAt'])
        && data.keys().hasOnly(['emailHash', 'uid', 'email', 'displayName', 'username', 'updatedAt'])
        && data.emailHash is string
        && data.emailHash == emailHash
        && isValidEmailHash(data.emailHash)
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 120
        && (!('username' in data) || data.username == null || isValidUsername(data.username))
        && data.updatedAt is timestamp;
    }

    function isValidOrgMemberCreate(data, memberUid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'joinedAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'username',
          'role',
          'department',
          'spendingLimit',
          'spendingLimitMinor',
          'status',
          'joinedAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == memberUid
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 120
        && (!('username' in data) || data.username == null || isValidUsername(data.username))
        && data.role in ['admin', 'accountant', 'employee', 'viewer']
        && (!('department' in data) || data.department == null || (data.department is string && data.department.size() <= 80))
        && (!('spendingLimit' in data) || data.spendingLimit == null || (data.spendingLimit is number && data.spendingLimit > 0 && data.spendingLimit <= 1000000000))
        && (!('spendingLimitMinor' in data) || data.spendingLimitMinor == null || (data.spendingLimitMinor is int && data.spendingLimitMinor > 0))
        && data.status == 'active'
        && data.joinedAt is number
        && data.joinedAt > 0
        && data.updatedAt is timestamp;
    }

    function isValidOrgRefCreate(data, orgId) {
      return data.keys().hasAll(['orgId', 'orgName', 'role', 'status', 'currency', 'joinedAt'])
        && data.keys().hasOnly(['orgId', 'orgName', 'role', 'status', 'currency', 'joinedAt'])
        && data.orgId is string
        && data.orgId == orgId
        && isValidId(data.orgId)
        && data.orgName is string
        && data.orgName.size() > 0
        && data.orgName.size() <= 120
        && data.role in ['admin', 'accountant', 'employee', 'viewer']
        && data.status == 'active'
        && data.currency is string
        && data.currency.size() > 0
        && data.currency.size() <= 8
        && data.joinedAt is number
        && data.joinedAt > 0;
    }

    function isValidUserProfileCreate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'isPro', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'username',
          'photoURL',
          'hasCompletedOnboarding',
          'isPro',
          'proActive',
          'proPlan',
          'planTier',
          'billingCycle',
          'startedAt',
          'expiresAt',
          'proExpiresAt',
          'hasUsedBusinessTrial',
          'redeemedCouponCode',
          'currencyRates',
          'settings',
          'lastSyncedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() <= 128
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 254
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 120))
        && (!('username' in data) || data.username == null || isValidUsername(data.username))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('hasCompletedOnboarding' in data) || data.hasCompletedOnboarding == null || data.hasCompletedOnboarding is bool)
        && data.isPro == false
        && (!('proActive' in data) || data.proActive == false)
        && (!('proPlan' in data) || data.proPlan == 'free')
        && (!('planTier' in data) || data.planTier == 'free')
        && (!('billingCycle' in data) || data.billingCycle == 'free')
        && (!('startedAt' in data) || data.startedAt == null)
        && (!('expiresAt' in data) || data.expiresAt == null)
        && (!('proExpiresAt' in data) || data.proExpiresAt == null)
        && (!('hasUsedBusinessTrial' in data) || data.hasUsedBusinessTrial == false)
        && (!('redeemedCouponCode' in data) || data.redeemedCouponCode == null)
        && (!('currencyRates' in data) || data.currencyRates == null || (data.currencyRates is map && data.currencyRates.size() <= 250))
        && (!('settings' in data) || data.settings == null || (data.settings is map && data.settings.size() <= 60))
        && (!('lastSyncedAt' in data) || data.lastSyncedAt == null || data.lastSyncedAt is number)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProfileUpdate(data, userId) {
      return data.keys().hasAll(['updatedAt'])
        && (!('uid' in data) || (data.uid is string && data.uid.size() <= 128 && data.uid == userId && (data.uid == request.auth.uid || isAdmin())))
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 254))
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 120))
        && (!('username' in data) || data.username == null || isValidUsername(data.username))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('hasCompletedOnboarding' in data) || data.hasCompletedOnboarding == null || data.hasCompletedOnboarding is bool)
        && (!('isPro' in data) || data.isPro == null || data.isPro is bool)
        && (!('proActive' in data) || data.proActive == null || data.proActive is bool)
        && (!('proPlan' in data) || data.proPlan == null || data.proPlan in ['free', 'monthly', 'yearly', 'lifetime', 'business_monthly', 'business_yearly', 'trial', 'code'])
        && (!('planTier' in data) || data.planTier == null || data.planTier in ['free', 'personal_pro', 'business_pro', 'business'])
        && (!('billingCycle' in data) || data.billingCycle == null || data.billingCycle in ['free', 'monthly', 'yearly', 'lifetime', 'trial', 'code'])
        && (!('startedAt' in data) || data.startedAt == null || data.startedAt is number || data.startedAt is timestamp)
        && (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is number || data.expiresAt is timestamp)
        && (!('proExpiresAt' in data) || data.proExpiresAt == null || data.proExpiresAt is number || data.proExpiresAt is timestamp)
        && (!('hasUsedBusinessTrial' in data) || data.hasUsedBusinessTrial == null || data.hasUsedBusinessTrial is bool)
        && (!('activationCodeHash' in data) || data.activationCodeHash == null || (data.activationCodeHash is string && data.activationCodeHash.size() <= 128))
        && (!('redeemedCouponCode' in data) || data.redeemedCouponCode == null || data.redeemedCouponCode == '' || (data.redeemedCouponCode is string && data.redeemedCouponCode.size() <= 128 && data.redeemedCouponCode.matches('^[a-zA-Z0-9_\\-]+$')))
        && (!('currencyRates' in data) || data.currencyRates == null || (data.currencyRates is map && data.currencyRates.size() <= 250))
        && (!('settings' in data) || data.settings == null || (data.settings is map && data.settings.size() <= 60))
        && (!('lastSyncedAt' in data) || data.lastSyncedAt == null || data.lastSyncedAt is number)
        && (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp || data.createdAt is number)
        && data.updatedAt is timestamp;
    }

    function isValidBackupMeta(data, userId) {
      return data.keys().hasAll([
        'uid',
        'schemaVersion',
        'chunkCount',
        'totalTransactions',
        'wallets',
        'categories',
        'budgets',
        'debts',
        'goals',
        'templates',
        'settings',
        'hasCompletedOnboarding',
        'updatedAtMs',
        'updatedAt'
      ])
        && data.keys().hasOnly([
          'uid',
          'schemaVersion',
          'chunkCount',
          'totalTransactions',
          'wallets',
          'categories',
          'budgets',
          'debts',
          'goals',
          'templates',
          'moneyCircles',
          'orgWorkspaces',
          'activeWorkspace',
          'settings',
          'hasCompletedOnboarding',
          'updatedAtMs',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() <= 128
        && data.schemaVersion is int
        && data.schemaVersion >= 1
        && data.schemaVersion <= 10
        && data.chunkCount is int
        && data.chunkCount >= 0
        && data.chunkCount <= 100
        && data.totalTransactions is int
        && data.totalTransactions >= 0
        && data.totalTransactions <= 40000
        && data.wallets is list
        && data.wallets.size() <= 200
        && (data.wallets.size() == 0 || data.wallets[0] is map)
        && data.categories is list
        && data.categories.size() <= 300
        && (data.categories.size() == 0 || data.categories[0] is map)
        && data.budgets is list
        && data.budgets.size() <= 200
        && (data.budgets.size() == 0 || data.budgets[0] is map)
        && data.debts is list
        && data.debts.size() <= 500
        && (data.debts.size() == 0 || data.debts[0] is map)
        && data.goals is list
        && data.goals.size() <= 200
        && (data.goals.size() == 0 || data.goals[0] is map)
        && data.templates is list
        && data.templates.size() <= 300
        && (data.templates.size() == 0 || data.templates[0] is map)
        && (!('moneyCircles' in data) || data.moneyCircles == null || (data.moneyCircles is list && data.moneyCircles.size() <= 200))
        && (!('orgWorkspaces' in data) || data.orgWorkspaces == null || (data.orgWorkspaces is map && data.orgWorkspaces.size() <= 50))
        && (!('activeWorkspace' in data) || data.activeWorkspace == null || (data.activeWorkspace is string && data.activeWorkspace.size() > 0 && data.activeWorkspace.size() <= 128))
        && data.settings is map
        && data.hasCompletedOnboarding is bool
        && data.updatedAtMs is number
        && (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is number)
        && data.updatedAt is timestamp;
    }

    function isValidBackupChunk(data, userId) {
      return data.keys().hasAll(['uid', 'chunkIndex', 'transactions', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'chunkIndex', 'transactions', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() <= 128
        && data.chunkIndex is int
        && data.chunkIndex >= 0
        && data.chunkIndex < 100
        && data.transactions is list
        && data.transactions.size() <= 500
        && (data.transactions.size() == 0 || data.transactions[0] is map)
        && data.updatedAt is timestamp;
    }

    function isValidBackupHistoryEntry(data, userId, backupId) {
      return data.keys().hasAll([
        'id',
        'uid',
        'source',
        'createdAtMs',
        'totalTransactions',
        'storedTransactionsCount',
        'walletsCount',
        'snapshotJson',
        'createdAt'
      ])
        && data.keys().hasOnly([
          'id',
          'uid',
          'source',
          'createdAtMs',
          'totalTransactions',
          'storedTransactionsCount',
          'walletsCount',
          'snapshotJson',
          'createdAt'
        ])
        && data.id is string
        && data.id == backupId
        && isValidId(data.id)
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.source in ['auto', 'manual']
        && data.createdAtMs is number
        && data.createdAtMs > 0
        && data.totalTransactions is int
        && data.totalTransactions >= 0
        && data.storedTransactionsCount is int
        && data.storedTransactionsCount >= 0
        && data.walletsCount is int
        && data.walletsCount >= 0
        && data.snapshotJson is string
        && data.snapshotJson.size() > 0
        && data.snapshotJson.size() <= 900000
        && data.createdAt is timestamp;
    }

    function isValidWorkspaceTransaction(data, userId, workspaceId, txId) {
      return data.keys().hasAll([
        'id',
        'uid',
        'workspaceId',
        'date',
        'type',
        'amount',
        'currency',
        'walletId',
        'categoryId',
        'payload',
        'updatedAt'
      ])
        && data.keys().hasOnly([
          'id',
          'uid',
          'workspaceId',
          'date',
          'time',
          'type',
          'amount',
          'amountMinor',
          'currency',
          'walletId',
          'toWalletId',
          'categoryId',
          'createdAtMs',
          'updatedAtMs',
          'deletedAt',
          'payload',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id == txId && isValidId(data.id)
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid)
        && data.workspaceId is string && data.workspaceId == workspaceId && isValidId(data.workspaceId)
        && data.date is string && data.date.size() > 0 && data.date.size() <= 16
        && (!('time' in data) || (data.time is string && data.time.size() <= 16))
        && data.type in ['expense', 'income', 'transfer']
        && data.amount is number && data.amount >= 0 && data.amount <= 1000000000
        && (!('amountMinor' in data) || (data.amountMinor is int && data.amountMinor >= 0))
        && data.currency is string && data.currency.size() > 0 && data.currency.size() <= 8
        && data.walletId is string && data.walletId.size() > 0 && data.walletId.size() <= 128
        && (!('toWalletId' in data) || data.toWalletId == null || (data.toWalletId is string && data.toWalletId.size() <= 128))
        && data.categoryId is string && data.categoryId.size() <= 128
        && (!('createdAtMs' in data) || (data.createdAtMs is number && data.createdAtMs >= 0))
        && (!('updatedAtMs' in data) || (data.updatedAtMs is number && data.updatedAtMs >= 0))
        && (!('deletedAt' in data) || data.deletedAt == null || (data.deletedAt is number && data.deletedAt >= 0))
        && data.payload is map && data.payload.size() <= 55
        && (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is number)
        && data.updatedAt is timestamp;
    }

    function isValidOrgSettingsUpdate(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.currency is string && data.currency.size() > 0 && data.currency.size() <= 8
        && (!('industry' in data) || data.industry in ['retail', 'restaurant', 'tech', 'construction', 'medical', 'general'])
        && data.vatRate is number && data.vatRate >= 0 && data.vatRate <= 100
        && data.approvalThreshold is number && data.approvalThreshold >= 0 && data.approvalThreshold <= 1000000000
        && (!('taxNumber' in data) || data.taxNumber == null || (data.taxNumber is string && data.taxNumber.size() <= 64))
        && (!('lockedUntilDate' in data) || data.lockedUntilDate == null || (data.lockedUntilDate is string && data.lockedUntilDate.size() <= 16));
    }

    function isValidOrgAdminSubscriptionUpdate(data) {
      return (!('planTier' in data) || data.planTier in ['free', 'personal_pro', 'business_pro'])
        && (!('billingCycle' in data) || data.billingCycle in ['free', 'monthly', 'yearly', 'lifetime', 'trial'])
        && (!('plan' in data) || data.plan in ['trial', 'business_monthly', 'business_yearly'])
        && (!('expiresAt' in data) || data.expiresAt == null || (data.expiresAt is number && data.expiresAt > 0))
        && (!('subscriptionEndsAt' in data) || data.subscriptionEndsAt == null || (data.subscriptionEndsAt is number && data.subscriptionEndsAt > 0))
        && (!('aiScansLimit' in data) || (data.aiScansLimit is int && data.aiScansLimit >= 0 && data.aiScansLimit <= 10000))
        && data.updatedAt is timestamp;
    }

    function isValidCostCenter(data, orgId, ccId) {
      return data.keys().hasAll(['id', 'orgId', 'code', 'nameAr', 'nameEn', 'budgetAllocated', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'orgId', 'code', 'name', 'nameAr', 'nameEn', 'type',
          'budgetAllocated', 'budgetAllocatedMinor', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == ccId && isValidId(data.id)
        && data.orgId is string && data.orgId == orgId
        && data.code is string && data.code.size() > 0 && data.code.size() <= 32
        && (!('name' in data) || (data.name is string && data.name.size() <= 120))
        && data.nameAr is string && data.nameAr.size() > 0 && data.nameAr.size() <= 120
        && data.nameEn is string && data.nameEn.size() > 0 && data.nameEn.size() <= 120
        && (!('type' in data) || data.type in ['department', 'project', 'branch'])
        && data.budgetAllocated is number && data.budgetAllocated >= 0 && data.budgetAllocated <= 1000000000
        && (!('budgetAllocatedMinor' in data) || (data.budgetAllocatedMinor is int && data.budgetAllocatedMinor >= 0))
        && data.isActive is bool
        && data.createdAt is number && data.createdAt >= 0
        && data.updatedAt is timestamp;
    }

    function isValidBusinessParty(data, orgId, partyId) {
      return data.keys().hasAll(['id', 'orgId', 'type', 'name', 'currency', 'balance', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'orgId', 'type', 'name', 'phone', 'email', 'taxId', 'creditLimit',
          'currency', 'balance', 'balanceMinor', 'dueDate', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == partyId && isValidId(data.id)
        && data.orgId is string && data.orgId == orgId
        && data.type in ['vendor', 'client', 'both']
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('taxId' in data) || (data.taxId is string && data.taxId.size() <= 64))
        && (!('creditLimit' in data) || (data.creditLimit is number && data.creditLimit >= 0 && data.creditLimit <= 1000000000))
        && data.currency is string && data.currency.size() > 0 && data.currency.size() <= 8
        && data.balance is number && data.balance >= -1000000000 && data.balance <= 1000000000
        && (!('balanceMinor' in data) || data.balanceMinor is int)
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 16))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 400))
        && data.createdAt is number && data.createdAt >= 0
        && data.updatedAt is timestamp;
    }

    function isValidOrgLedgerRecord(data, orgId, docId) {
      return data.keys().hasAll(['id', 'orgId', 'payload', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'orgId', 'date', 'amountMinor', 'balanceMinor', 'submittedBy',
          'approvedBy', 'approvalStatus', 'deletedAt', 'payload', 'updatedAt'
        ])
        && data.id is string && data.id == docId && isValidId(data.id)
        && data.orgId is string && data.orgId == orgId
        && (!('date' in data) || (data.date is string && data.date.size() <= 16))
        && (!('amountMinor' in data) || (
          data.amountMinor is int
          && data.amountMinor >= 0
          && 'amount' in data.payload
          && isConsistentAmountMinor(orgId, data)
        ))
        && (!('balanceMinor' in data) || data.balanceMinor is int)
        && (!('submittedBy' in data) || (data.submittedBy is string && data.submittedBy.size() <= 128))
        && (!('approvedBy' in data) || data.approvedBy == null || (data.approvedBy is string && data.approvedBy.size() <= 128))
        && (!('approvalStatus' in data) || data.approvalStatus in ['draft', 'pending', 'pending_approval', 'approved', 'rejected', 'paid'])
        && (!('deletedAt' in data) || data.deletedAt == null || data.deletedAt is number)
        && data.payload is map && data.payload.size() <= 55
        && data.updatedAt is timestamp;
    }

    function isValidAuditLogEntry(data, orgId, logId) {
      return data.keys().hasAll(['id', 'orgId', 'action', 'entityType', 'entityId', 'actorUid', 'actorName', 'summary', 'timestamp', 'createdAt'])
        && data.keys().hasOnly(['id', 'orgId', 'action', 'entityType', 'entityId', 'actorUid', 'actorName', 'summary', 'before', 'after', 'timestamp', 'createdAt'])
        && data.id is string && data.id == logId && isValidId(data.id)
        && data.orgId is string && data.orgId == orgId
        && data.action in [
          'create', 'update', 'delete', 'restore', 'approve', 'reject',
          'lock_period', 'role_change', 'invite_create', 'invite_revoke',
          'member_join', 'member_remove', 'transfer_ownership', 'recalculate'
        ]
        && data.entityType is string && data.entityType.size() > 0 && data.entityType.size() <= 40
        && data.entityId is string && data.entityId.size() > 0 && data.entityId.size() <= 128
        && data.actorUid is string && data.actorUid == request.auth.uid
        && data.actorName is string && data.actorName.size() > 0 && data.actorName.size() <= 120
        && data.summary is string && data.summary.size() > 0 && data.summary.size() <= 300
        && data.timestamp is number && data.timestamp >= 0
        && data.createdAt is timestamp;
    }

    // Primary encrypted admin panel PIN config (adminConfig/security) accessible solely by exclusive system admin
    match /adminConfig/{docId} {
      allow get: if isAdmin() && isValidId(docId) && docId == 'security';
      allow list: if false;
      allow create, update: if isAdmin()
        && isValidId(docId)
        && docId == 'security'
        && isValidAdminPanelConfig(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Legacy encrypted admin panel PIN path (read-only fallback for seamless migration)
    match /adminSecurity/{docId} {
      allow get: if isAdmin() && isValidId(docId) && docId == 'panelConfig';
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Server-only collections: never accessible from normal clients
    match /activationCodes/{codeHash} {
      allow read, write: if false;
    }

    match /licenseCodes/{codeHash} {
      allow read, write: if false;
    }

    match /adminIssuedCodes/{codeHash} {
      allow read, write: if false;
    }

    match /coupons/{couponId} {
      allow read, write: if false;
    }

    match /joinRateLimits/{uid} {
      allow read, write: if false;
    }

    match /proLicenses/{licenseId} {
      allow read, write: if false;
    }

    match /paymentWebhooks/{eventId} {
      allow read, write: if false;
    }

    // Global unique @username reservation & exact-lookup directory (no collection listing/scraping)
    match /usernames/{username} {
      allow get: if isSignedIn() && isValidUsername(username);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidUsername(username)
        && isValidUsernameRecord(incoming(), username)
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidUsername(username)
        && isValidUsernameRecord(incoming(), username)
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().username == existing().username
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);
      allow delete: if isSignedIn()
        && isValidUsername(username)
        && existing().uid == request.auth.uid;
    }

    // Exact-email SHA-256 lookup index for direct organization member addition (never listable)
    match /userEmailIndex/{emailHash} {
      allow get: if isSignedIn() && isValidEmailHash(emailHash);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidEmailHash(emailHash)
        && isValidUserEmailIndexRecord(incoming(), emailHash)
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && incoming().email.trim().lower() == request.auth.token.email.trim().lower()
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidEmailHash(emailHash)
        && isValidUserEmailIndexRecord(incoming(), emailHash)
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().emailHash == existing().emailHash
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && incoming().email.trim().lower() == request.auth.token.email.trim().lower()
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'username', 'updatedAt']);
      allow delete: if isSignedIn()
        && isValidEmailHash(emailHash)
        && existing().uid == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfileCreate(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUserProfileUpdate(incoming(), userId)
        && (!('uid' in existing()) || incoming().uid == existing().uid)
        && (!('createdAt' in existing()) || incoming().get('createdAt', null) == existing().get('createdAt', null))
        && incoming().updatedAt == request.time
        && (
          (
            isOwner(userId)
            && incoming().get('isPro', false) == existing().get('isPro', false)
            && incoming().get('proActive', false) == existing().get('proActive', false)
            && incoming().get('proPlan', 'free') == existing().get('proPlan', 'free')
            && incoming().get('planTier', 'free') == existing().get('planTier', 'free')
            && incoming().get('billingCycle', 'free') == existing().get('billingCycle', 'free')
            && incoming().get('startedAt', null) == existing().get('startedAt', null)
            && incoming().get('expiresAt', null) == existing().get('expiresAt', null)
            && incoming().get('proExpiresAt', null) == existing().get('proExpiresAt', null)
            && incoming().get('hasUsedBusinessTrial', false) == existing().get('hasUsedBusinessTrial', false)
            && incoming().get('redeemedCouponCode', null) == existing().get('redeemedCouponCode', null)
            && (
              !('username' in incoming().diff(existing()).affectedKeys())
              || incoming().username == null
              || (
                isValidUsername(incoming().username)
                && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.uid == userId
              )
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'uid',
              'email',
              'displayName',
              'username',
              'photoURL',
              'hasCompletedOnboarding',
              'currencyRates',
              'settings',
              'lastSyncedAt',
              'updatedAt'
            ])
          )
          ||
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'isPro',
              'proActive',
              'planTier',
              'proPlan',
              'billingCycle',
              'startedAt',
              'expiresAt',
              'proExpiresAt',
              'redeemedCouponCode',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isOwner(userId);

      // Server-only monthly receipt scan quota
      match /scanQuotas/{monthKey} {
        allow read, write: if false;
      }

      // Organization membership index (synced atomically with organizations/{orgId}/members/{userId})
      match /orgRefs/{orgId} {
        allow get: if isValidId(userId) && isValidId(orgId) && (isOwner(userId) || isOrgOwnerOrAdmin(orgId));
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId)
          && isValidId(orgId)
          && isVerifiedUser()
          && isOrgOwnerOrAdmin(orgId)
          && isOrgWritable(orgId)
          && isValidOrgRefCreate(incoming(), orgId)
          && existsAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(userId));
        allow update: if isValidId(userId)
          && isValidId(orgId)
          && isVerifiedUser()
          && isOrgOwnerOrAdmin(orgId)
          && isOrgWritable(orgId)
          && existing().role != 'owner'
          && incoming().role in ['admin', 'accountant', 'employee', 'viewer']
          && incoming().status in ['active', 'suspended']
          && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status']);
        allow delete: if isValidId(userId)
          && isValidId(orgId)
          && isVerifiedUser()
          && isOrgOwnerOrAdmin(orgId)
          && isOrgWritable(orgId)
          && userId != request.auth.uid
          && existing().role != 'owner'
          && !existsAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(userId));
      }

      // Chunked personal backup metadata (users/{uid}/backup/meta)
      match /backup/{docId} {
        allow get: if isValidId(userId)
          && isValidId(docId)
          && docId == 'meta'
          && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(docId)
          && docId == 'meta'
          && isOwner(userId)
          && isValidBackupMeta(incoming(), userId)
          && ('createdAt' in incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(docId)
          && docId == 'meta'
          && isOwner(userId)
          && isValidBackupMeta(incoming(), userId)
          && (!('uid' in existing()) || incoming().uid == existing().uid)
          && (!('createdAt' in existing()) || incoming().get('createdAt', null) == existing().get('createdAt', null))
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'schemaVersion',
            'chunkCount',
            'totalTransactions',
            'wallets',
            'categories',
            'budgets',
            'debts',
            'goals',
            'templates',
            'moneyCircles',
            'orgWorkspaces',
            'activeWorkspace',
            'settings',
            'hasCompletedOnboarding',
            'updatedAtMs',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId)
          && isValidId(docId)
          && docId == 'meta'
          && isOwner(userId);
      }

      // Chunked personal backup transaction slices
      match /backupChunks/{chunkId} {
        allow get: if isValidId(userId)
          && isValidId(chunkId)
          && isOwner(userId);
        allow list: if isValidId(userId)
          && isOwner(userId);
        allow create: if isValidId(userId)
          && isValidId(chunkId)
          && isOwner(userId)
          && isValidBackupChunk(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(chunkId)
          && isOwner(userId)
          && isValidBackupChunk(incoming(), userId)
          && (!('uid' in existing()) || incoming().uid == existing().uid)
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'chunkIndex',
            'transactions',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId)
          && isValidId(chunkId)
          && isOwner(userId);
      }

      // Legacy single-document backup: read/delete only
      match /backups/{backupId} {
        allow get: if isValidId(userId)
          && isValidId(backupId)
          && isOwner(userId);
        allow list: if false;
        allow create, update: if false;
        allow delete: if isValidId(userId)
          && isValidId(backupId)
          && isOwner(userId);
      }

      // Rolling history of the last 7 automatic cloud backups
      match /backupHistory/{backupId} {
        allow get: if isValidId(userId)
          && isValidId(backupId)
          && isOwner(userId);
        allow list: if isValidId(userId)
          && isOwner(userId)
          && (request.query.limit == null || request.query.limit <= 30);
        allow create: if isValidId(userId)
          && isValidId(backupId)
          && isOwner(userId)
          && isValidBackupHistoryEntry(incoming(), userId, backupId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId)
          && isValidId(backupId)
          && isOwner(userId);
      }

      // Unified workspace-scoped real-time transactions (personal + user-owned workspaces)
      match /workspaces/{workspaceId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow write: if false;

        match /transactions/{txId} {
          allow get: if isValidId(userId)
            && isValidId(workspaceId)
            && isValidId(txId)
            && isOwner(userId);
          allow list: if isValidId(userId)
            && isValidId(workspaceId)
            && isOwner(userId);
          allow create: if isValidId(userId)
            && isValidId(workspaceId)
            && isValidId(txId)
            && isOwner(userId)
            && isValidWorkspaceTransaction(incoming(), userId, workspaceId, txId)
            && incoming().updatedAt == request.time;
          allow update: if isValidId(userId)
            && isValidId(workspaceId)
            && isValidId(txId)
            && isOwner(userId)
            && isValidWorkspaceTransaction(incoming(), userId, workspaceId, txId)
            && (!('uid' in existing()) || incoming().uid == existing().uid)
            && (!('id' in existing()) || incoming().id == existing().id)
            && (!('workspaceId' in existing()) || incoming().workspaceId == existing().workspaceId)
            && (!('createdAt' in existing()) || incoming().get('createdAt', null) == existing().get('createdAt', null))
            && incoming().updatedAt == request.time;
          allow delete: if isValidId(userId)
            && isValidId(workspaceId)
            && isValidId(txId)
            && isOwner(userId);
        }
      }
    }

    // =========================================================================
    // Enterprise Organizations & Multi-Role RBAC Subcollections
    // =========================================================================
    match /organizations/{orgId} {
      allow get: if isValidId(orgId) && (isOrgMemberActive(orgId) || isAdmin());
      allow list: if isAdmin();
      // Organization lifecycle (create, delete, ownership) is server-only
      allow create, delete: if false;
      allow update: if isValidId(orgId)
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isVerifiedUser()
            && isOrgOwnerOrAdmin(orgId)
            && isOrgWritable(orgId)
            && isValidOrgSettingsUpdate(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'currency',
              'industry',
              'vatRate',
              'taxNumber',
              'approvalThreshold',
              'lockedUntilDate',
              'updatedAt'
            ])
          )
          ||
          (
            isAdmin()
            && isValidOrgAdminSubscriptionUpdate(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'planTier',
              'billingCycle',
              'plan',
              'expiresAt',
              'subscriptionEndsAt',
              'aiScansLimit',
              'updatedAt'
            ])
          )
        );

      match /members/{memberUid} {
        allow get, list: if isValidId(orgId) && isOrgMemberActive(orgId);
        allow create: if isValidId(orgId)
          && isValidId(memberUid)
          && isVerifiedUser()
          && isOrgOwnerOrAdmin(orgId)
          && isOrgWritable(orgId)
          && isValidOrgMemberCreate(incoming(), memberUid)
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(memberUid)/orgRefs/$(orgId));
        allow update: if isValidId(orgId)
          && isValidId(memberUid)
          && isVerifiedUser()
          && isOrgOwnerOrAdmin(orgId)
          && isOrgWritable(orgId)
          && existing().role != 'owner'
          && incoming().role in ['admin', 'accountant', 'employee', 'viewer']
          && incoming().status in ['active', 'suspended']
          && (!('department' in incoming()) || incoming().department == null || (incoming().department is string && incoming().department.size() <= 80))
          && (!('spendingLimit' in incoming()) || incoming().spendingLimit == null || (incoming().spendingLimit is number && incoming().spendingLimit > 0 && incoming().spendingLimit <= 1000000000))
          && (!('spendingLimitMinor' in incoming()) || incoming().spendingLimitMinor == null || (incoming().spendingLimitMinor is int && incoming().spendingLimitMinor > 0))
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'role',
            'status',
            'department',
            'spendingLimit',
            'spendingLimitMinor',
            'updatedAt'
          ]);
        allow delete: if isValidId(orgId)
          && isValidId(memberUid)
          && isVerifiedUser()
          && isOrgOwnerOrAdmin(orgId)
          && isOrgWritable(orgId)
          && memberUid != request.auth.uid
          && existing().role != 'owner'
          && !existsAfter(/databases/$(database)/documents/users/$(memberUid)/orgRefs/$(orgId));
      }

      match /invites/{inviteId} {
        allow read, write: if false;
      }

      match /scanQuotas/{monthKey} {
        allow read, write: if false;
      }

      match /costCenters/{costCenterId} {
        allow get, list: if isValidId(orgId) && isOrgMemberActive(orgId);
        allow create: if isValidId(orgId)
          && isValidId(costCenterId)
          && isVerifiedUser()
          && isOrgAccountantOrAbove(orgId)
          && isOrgWritable(orgId)
          && isValidCostCenter(incoming(), orgId, costCenterId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(orgId)
          && isValidId(costCenterId)
          && isVerifiedUser()
          && isOrgAccountantOrAbove(orgId)
          && isOrgWritable(orgId)
          && isValidCostCenter(incoming(), orgId, costCenterId)
          && incoming().id == existing().id
          && incoming().orgId == existing().orgId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'code',
            'name',
            'nameAr',
            'nameEn',
            'type',
            'budgetAllocated',
            'budgetAllocatedMinor',
            'isActive',
            'updatedAt'
          ]);
        allow delete: if isValidId(orgId)
          && isValidId(costCenterId)
          && isVerifiedUser()
          && isOrgOwnerOrAdmin(orgId)
          && isOrgWritable(orgId);
      }

      match /parties/{partyId} {
        allow get, list: if isValidId(orgId) && isOrgMemberActive(orgId);
        allow create: if isValidId(orgId)
          && isValidId(partyId)
          && isVerifiedUser()
          && isOrgAccountantOrAbove(orgId)
          && isOrgWritable(orgId)
          && isValidBusinessParty(incoming(), orgId, partyId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(orgId)
          && isValidId(partyId)
          && isVerifiedUser()
          && isOrgAccountantOrAbove(orgId)
          && isOrgWritable(orgId)
          && isValidBusinessParty(incoming(), orgId, partyId)
          && incoming().id == existing().id
          && incoming().orgId == existing().orgId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'type',
            'name',
            'phone',
            'email',
            'taxId',
            'creditLimit',
            'currency',
            'balance',
            'balanceMinor',
            'dueDate',
            'notes',
            'updatedAt'
          ]);
        allow delete: if isValidId(orgId)
          && isValidId(partyId)
          && isVerifiedUser()
          && isOrgOwnerOrAdmin(orgId)
          && isOrgWritable(orgId);
      }

      match /transactions/{txId} {
        allow get, list: if isValidId(orgId) && isOrgMemberActive(orgId);
        allow create: if isValidId(orgId)
          && isValidId(txId)
          && isVerifiedUser()
          && isOrgContributorOrAbove(orgId)
          && isOrgWritable(orgId)
          && isValidOrgLedgerRecord(incoming(), orgId, txId)
          && incoming().updatedAt == request.time
          && isAfterPeriodLock(orgId, incoming().get('date', incoming().payload.get('date', '')))
          && (
            isOrgAccountantOrAbove(orgId)
            || (
              incoming().submittedBy == request.auth.uid
              && incoming().approvalStatus in ['draft', 'pending']
              && isWithinEmployeeSpendingLimit(orgId, incoming())
            )
          );
        allow update: if isValidId(orgId)
          && isValidId(txId)
          && isVerifiedUser()
          && isOrgContributorOrAbove(orgId)
          && isOrgWritable(orgId)
          && isValidOrgLedgerRecord(incoming(), orgId, txId)
          && incoming().id == existing().id
          && incoming().orgId == existing().orgId
          && incoming().updatedAt == request.time
          && isAfterPeriodLock(orgId, existing().get('date', existing().payload.get('date', '')))
          && isAfterPeriodLock(orgId, incoming().get('date', incoming().payload.get('date', '')))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'date', 'amountMinor', 'approvedBy', 'approvalStatus', 'deletedAt', 'payload', 'updatedAt'
          ])
          && (
            isOrgAccountantOrAbove(orgId)
            || (
              existing().submittedBy == request.auth.uid
              && existing().get('approvalStatus', 'pending') in ['draft', 'pending', 'rejected']
              && incoming().get('approvalStatus', 'pending') in ['draft', 'pending']
              && isWithinEmployeeSpendingLimit(orgId, incoming())
            )
          );
        allow delete: if isValidId(orgId)
          && isValidId(txId)
          && isVerifiedUser()
          && isOrgOwnerOrAdmin(orgId)
          && isOrgWritable(orgId);
      }

      match /wallets/{walletId} {
        allow get, list: if isValidId(orgId) && isOrgMemberActive(orgId);
        allow create: if isValidId(orgId)
          && isValidId(walletId)
          && isVerifiedUser()
          && isOrgAccountantOrAbove(orgId)
          && isOrgWritable(orgId)
          && isValidOrgLedgerRecord(incoming(), orgId, walletId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(orgId)
          && isValidId(walletId)
          && isVerifiedUser()
          && isOrgAccountantOrAbove(orgId)
          && isOrgWritable(orgId)
          && isValidOrgLedgerRecord(incoming(), orgId, walletId)
          && incoming().id == existing().id
          && incoming().orgId == existing().orgId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['balanceMinor', 'payload', 'updatedAt']);
        allow delete: if isValidId(orgId)
          && isValidId(walletId)
          && isVerifiedUser()
          && isOrgOwnerOrAdmin(orgId)
          && isOrgWritable(orgId);
      }

      match /categories/{categoryId} {
        allow get, list: if isValidId(orgId) && isOrgMemberActive(orgId);
        allow create: if isValidId(orgId)
          && isValidId(categoryId)
          && isVerifiedUser()
          && isOrgAccountantOrAbove(orgId)
          && isOrgWritable(orgId)
          && isValidOrgLedgerRecord(incoming(), orgId, categoryId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(orgId)
          && isValidId(categoryId)
          && isVerifiedUser()
          && isOrgAccountantOrAbove(orgId)
          && isOrgWritable(orgId)
          && isValidOrgLedgerRecord(incoming(), orgId, categoryId)
          && incoming().id == existing().id
          && incoming().orgId == existing().orgId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['payload', 'updatedAt']);
        allow delete: if isValidId(orgId)
          && isValidId(categoryId)
          && isVerifiedUser()
          && isOrgOwnerOrAdmin(orgId)
          && isOrgWritable(orgId);
      }

      match /budgets/{budgetId} {
        allow get, list: if isValidId(orgId) && isOrgMemberActive(orgId);
        allow create: if isValidId(orgId)
          && isValidId(budgetId)
          && isVerifiedUser()
          && isOrgAccountantOrAbove(orgId)
          && isOrgWritable(orgId)
          && isValidOrgLedgerRecord(incoming(), orgId, budgetId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(orgId)
          && isValidId(budgetId)
          && isVerifiedUser()
          && isOrgAccountantOrAbove(orgId)
          && isOrgWritable(orgId)
          && isValidOrgLedgerRecord(incoming(), orgId, budgetId)
          && incoming().id == existing().id
          && incoming().orgId == existing().orgId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['amountMinor', 'payload', 'updatedAt']);
        allow delete: if isValidId(orgId)
          && isValidId(budgetId)
          && isVerifiedUser()
          && isOrgOwnerOrAdmin(orgId)
          && isOrgWritable(orgId);
      }

      // Immutable append-only audit log
      match /auditLogs/{logId} {
        allow get, list: if isValidId(orgId) && isOrgAccountantOrAbove(orgId);
        allow create: if isValidId(orgId)
          && isValidId(logId)
          && isVerifiedUser()
          && isOrgContributorOrAbove(orgId)
          && isOrgWritable(orgId)
          && isValidAuditLogEntry(incoming(), orgId, logId)
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
