rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified()
        && (
          request.auth.token.admin == true
          || (
            request.auth.token.email is string
            && request.auth.token.email.lower() == 'hapaypal2003@gmail.com'
          )
        );
    }

    function memberPath(orgId) {
      return /databases/ai-studio-1004f7e6-37de-49ad-89bd-ff8628597eea/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }

    function isActiveOrgMember(orgId) {
      return request.auth != null
        && firestore.exists(memberPath(orgId))
        && firestore.get(memberPath(orgId)).data.status == 'active';
    }

    function hasOrgRole(orgId, roles) {
      return isActiveOrgMember(orgId)
        && firestore.get(memberPath(orgId)).data.role in roles;
    }

    // Organization receipt attachments: max 2MB, image/pdf only, active contributor+ members only
    match /orgs/{orgId}/receipts/{txId}/{fileName} {
      allow read: if isActiveOrgMember(orgId) || isAdmin();

      allow create, update: if isVerified()
        && request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf')
        && (
          hasOrgRole(orgId, ['owner', 'admin', 'accountant', 'employee'])
          || isAdmin()
        );

      allow delete: if isVerified()
        && (
          hasOrgRole(orgId, ['owner', 'admin', 'accountant'])
          || isAdmin()
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
